# Copia este archivo como .env.local y llena los valores desde el dashboard de EmailJS.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Opcional: de dónde lee el panel /calidad sus datos. Por defecto, del calidad.json publicado en GitHub Pages.
# Para verlo con tus resultados locales: npm test && npm run calidad:local, y descomenta esta línea.
# VITE_CALIDAD_URL=/calidad.json
